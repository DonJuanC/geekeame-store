rules_version = '2';

// Enforcement real de roles: la UI (RequireAdmin, RequireAuth) solo oculta
// botones y rutas. Sin estas reglas, cualquier sesión autenticada podría
// escribir en "products", "orders" o "reviews" directamente desde el SDK de
// Firebase o la consola del navegador, sin pasar por la app.
//
// Cómo aplicarlas (ahora con firebase.json ya configurado):
//   firebase login
//   firebase use geekeame-store   # ver .firebaserc
//   firebase deploy --only firestore:rules,firestore:indexes
// También se puede seguir pegando este archivo a mano en Firebase Console →
// Firestore Database → Reglas → Publicar, pero el camino por CLI es el que
// mantiene este archivo (y firestore.indexes.json) como la fuente real de
// verdad en vez de una copia que hay que sincronizar a mano.
//
// Nota: firestore.indexes.json en este repo solo tiene documentado el
// índice compuesto confirmado (orders: userId + createdAt, ver Error 7 en
// la bitácora de IA/README) -- antes de depender de él como fuente
// completa, correr `firebase firestore:indexes > firestore.indexes.json`
// una vez logueado contra el proyecto real para traer la lista completa y
// exacta de lo que ya existe en producción.
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de usuario: cada quien lee/crea el suyo (se crea una sola vez
    // en el signup, ver authService.ts → ensureUserProfile). El rol se fija
    // en "customer" al crear y no se puede cambiar en el update propio
    // (compara contra resource.data.role): así ningún cliente puede
    // auto-asignarse admin, ni al crear su perfil ni editándolo después.
    // Un admin sí puede cambiar el rol de OTRO usuario (panel
    // /admin/users) -- nunca el propio, para no auto-degradarse por error
    // -- y únicamente ese campo, nada más del perfil ajeno.
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'customer';

      allow update: if request.auth != null && (
        (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
        ) || (
          request.auth.uid != userId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['customer', 'admin']
        )
      );
    }

    // Catálogo: lectura pública (lo ve cualquiera, logueado o no).
    // Alta y borrado: solo admin.
    // Update: admin puede modificar cualquier campo; un usuario logueado
    // (no admin) solo puede tocar "stock", y únicamente para bajarlo (nunca
    // subirlo) -- es exactamente lo que hace la transacción de checkout
    // (ordersService.ts) al descontar stock al confirmar una compra, y
    // evita que ese mismo permiso se pueda usar para inflar el stock de un
    // producto desde el cliente.
    match /products/{productId} {
      allow read: if true;

      allow create, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      allow update: if (
        request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      ) || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock < resource.data.stock
      );
    }

    // Reviews: lectura pública (se muestran en el detalle del producto a
    // cualquiera, logueado o no). Alta/edición: el propio usuario, con
    // rating validado en el servidor (entero 1-5) y userId forzado a que
    // coincida con el auth.uid -- así nadie puede publicar una review a
    // nombre de otro ni mandar un rating fuera de rango. Borrado: el dueño
    // de la review o un admin (moderación).
    match /reviews/{reviewId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Órdenes: un usuario solo lee/crea las propias (userId == su uid), y
    // toda orden nueva debe nacer en "pending" -- evita que alguien cree
    // directo desde el cliente una orden ya marcada "completed", saltando
    // el flujo real. Cambiar el estado (pending -> processing ->
    // completed/cancelled) queda reservado a admin, y el update solo puede
    // tocar "status"/"updatedAt": ni el admin puede reescribir items o
    // total de una orden ya creada.
    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      allow update: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // Listas de favoritos: cada lista es privada de su dueño -- ni
    // lectura pública (a diferencia de reviews/products) ni acceso de
    // admin, no hay razón de negocio para que nadie más las vea. userId
    // forzado a que coincida con el auth.uid al crear, e inmutable en el
    // update (misma lógica que el "role" en users): así nadie puede crear
    // una lista a nombre de otro ni transferir una lista existente
    // cambiándole el dueño.
    match /favoriteLists/{listId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

  }
}
